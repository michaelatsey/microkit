<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MicroKit.Domain/MicroKit.Domain.csproj" />
  </ItemGroup>

  <!-- TestClassConventionsTests reads this project's sources to check that every file declares a
       test, so helper types live next to the tests that use them. Copied, never compiled twice. -->
  <ItemGroup>
    <None Include="**/*.cs" Exclude="bin/**;obj/**" Link="test-sources/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The list of the sources compiled now: a copy of a deleted file can linger in the output, and
       must not be read as a source of this build. -->
  <Target Name="RequireTestSources" AfterTargets="CopyFilesToOutputDirectory">
    <WriteLinesToFile File="$(OutDir)test-sources/files.txt"
                      Lines="@(Compile->'%(Identity)'->Replace('\', '/'))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Error Condition="!Exists('$(OutDir)test-sources/TestClassConventionsTests.cs')"
           Text="The test sources were not copied to $(OutDir)test-sources; TestClassConventionsTests cannot run without them." />
  </Target>

</Project>
