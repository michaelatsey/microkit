<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MicroKit.Domain/MicroKit.Domain.csproj" />
  </ItemGroup>

  <!-- PublishedDocumentationTests read MicroKit.Domain.xml next to the test assembly. Copy the
       referenced project's documentation file explicitly, and fail the build if it is missing. -->
  <PropertyGroup>
    <AllowedReferenceRelatedFileExtensions>$(AllowedReferenceRelatedFileExtensions);.xml</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- DocumentationExamplesTests search the module's guides, performance notes, .claude/ files and
       README for samples of the surface #160 replaced. Copy them to the output, keeping their
       module-relative paths, and fail the build if they are missing. -->
  <ItemGroup>
    <None Include="../../docs/guides/**/*.md" Link="module-docs/docs/guides/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/performance/**/*.md" Link="module-docs/docs/performance/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../.claude/**/*.md" Link="module-docs/.claude/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../README.md" Link="module-docs/README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireModuleDocumentation" AfterTargets="CopyFilesToOutputDirectory">
    <Error Condition="!Exists('$(OutDir)module-docs/README.md') Or !Exists('$(OutDir)module-docs/docs/guides/Implementing-Aggregates.md') Or !Exists('$(OutDir)module-docs/.claude/rules/csharp-style.md')"
           Text="The module documentation was not copied to $(OutDir)module-docs; DocumentationExamplesTests cannot run without it." />
  </Target>

  <Target Name="RequireDomainDocumentationFile" AfterTargets="CopyFilesToOutputDirectory">
    <Error Condition="!Exists('$(OutDir)MicroKit.Domain.xml')"
           Text="MicroKit.Domain.xml is missing from $(OutDir); PublishedDocumentationTests cannot run without it." />
  </Target>

</Project>
