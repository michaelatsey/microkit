<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MicroKit.Domain/MicroKit.Domain.csproj" />
  </ItemGroup>

  <!-- PublishedDocumentationTests read MicroKit.Domain.xml next to the test assembly. The SDK
       default already copies a referenced project's .xml; appending it states the dependency in
       this file, so a change to that default cannot drop the file silently, and the target below
       fails the build if it is missing anyway. The extension is appended inside a target: set in
       the project body, the property would pre-empt the SDK default (.pdb, .xml, …), which is only
       applied when it is empty. -->
  <Target Name="CopyReferenceDocumentationFiles" BeforeTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <AllowedReferenceRelatedFileExtensions>$(AllowedReferenceRelatedFileExtensions);.xml</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>
  </Target>

  <!-- DocumentationExamplesTests search the module's guides, performance notes, .claude/ files and
       README for samples of the surface #160 replaced. Copy them to the output, keeping their
       module-relative paths, and fail the build if they are missing. -->
  <ItemGroup>
    <None Include="../../docs/guides/**/*.md" Link="module-docs/docs/guides/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/performance/**/*.md" Link="module-docs/docs/performance/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../.claude/**/*.md" Link="module-docs/.claude/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../README.md" Link="module-docs/README.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The auditable bases' sources, for the member-ordering rule of .claude/rules/csharp-style.md. -->
    <None Include="../../src/MicroKit.Domain/Aggregates/AuditableEntity.cs;../../src/MicroKit.Domain/Aggregates/AuditableAggregateRoot.cs" Link="module-src/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Outside module-docs/: the ADR quotes the replaced surface on purpose. -->
    <None Include="../../docs/architecture/ADR-003-Domain-Surface-Before-Stable.md" Link="module-adr/ADR-003-Domain-Surface-Before-Stable.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/architecture/ADR-004-Domain-Surface-Amendments.md" Link="module-adr/ADR-004-Domain-Surface-Amendments.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/architecture/ADR-001-Records-First-Value-Objects.md;../../docs/architecture/ADR-002-Domain-Events-Collection-Strategy.md" Link="module-adr/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The names of the module's source files, for the structure the module brain documents. -->
  <ItemGroup>
    <DomainSourceFile Include="../../src/MicroKit.Domain/**/*.cs" Exclude="../../src/MicroKit.Domain/bin/**;../../src/MicroKit.Domain/obj/**" />
  </ItemGroup>

  <Target Name="ListDomainSources" AfterTargets="CopyFilesToOutputDirectory">
    <WriteLinesToFile File="$(OutDir)module-src/files.txt"
                      Lines="@(DomainSourceFile->'%(Filename)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <!-- Their using directives, for the namespaces the purity rule allows. -->
    <ReadLinesFromFile File="%(DomainSourceFile.FullPath)">
      <Output TaskParameter="Lines" ItemName="DomainSourceLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <DomainUsing Include="@(DomainSourceLine)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^(global )?using System[A-Za-z.]*;$'))" />
    </ItemGroup>
    <WriteLinesToFile File="$(OutDir)module-src/usings.txt"
                      Lines="@(DomainUsing->Distinct())"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="RequireModuleDocumentation" AfterTargets="CopyFilesToOutputDirectory">
    <Error Condition="!Exists('$(OutDir)module-docs/README.md') Or !Exists('$(OutDir)module-docs/docs/guides/Implementing-Aggregates.md') Or !Exists('$(OutDir)module-docs/docs/performance/ValueObject-Benchmarks.md') Or !Exists('$(OutDir)module-docs/.claude/rules/csharp-style.md') Or !Exists('$(OutDir)module-adr/ADR-003-Domain-Surface-Before-Stable.md') Or !Exists('$(OutDir)module-adr/ADR-004-Domain-Surface-Amendments.md') Or !Exists('$(OutDir)module-adr/ADR-001-Records-First-Value-Objects.md') Or !Exists('$(OutDir)module-adr/ADR-002-Domain-Events-Collection-Strategy.md') Or !Exists('$(OutDir)module-src/AuditableEntity.cs') Or !Exists('$(OutDir)module-src/AuditableAggregateRoot.cs')"
           Text="The module documentation was not copied to $(OutDir)module-docs; DocumentationExamplesTests cannot run without it." />
  </Target>

  <Target Name="RequireDomainDocumentationFile" AfterTargets="CopyFilesToOutputDirectory">
    <Error Condition="!Exists('$(OutDir)MicroKit.Domain.xml')"
           Text="MicroKit.Domain.xml is missing from $(OutDir); PublishedDocumentationTests cannot run without it." />
  </Target>

</Project>
