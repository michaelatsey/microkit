<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- CS1591: no XML documentation on benchmark code.
         CA1822: BenchmarkDotNet only runs instance methods, so a [Benchmark] method that reads
         no instance data cannot be made static. -->
    <NoWarn>$(NoWarn);CS1591;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/MicroKit.Domain/MicroKit.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

</Project>