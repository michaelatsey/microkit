<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MicroKit.Result.Samples</AssemblyName>
    <RootNamespace>MicroKit.Result.Samples</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- A demo executable, never trimmed. The README samples call trim-unsafe APIs on purpose
         (MapGet/MapDelete with a delegate, ResultJsonConverterFactory); the trim analyzer that the
         root IsTrimmable=true turns on would report them as IL2026 build errors in Release. -->
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MicroKit.Result\MicroKit.Result.csproj" />
    <ProjectReference Include="..\..\src\MicroKit.Result.AspNetCore\MicroKit.Result.AspNetCore.csproj" />
  </ItemGroup>
</Project>
