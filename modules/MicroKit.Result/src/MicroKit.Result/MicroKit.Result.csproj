<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Turns on the trim, single-file and AOT analyzers (Microsoft Learn, "How to make libraries
         compatible with native AOT"): every IL2xxx/IL3xxx warning is fixed or carried by an explicit
         [RequiresUnreferencedCode]/[RequiresDynamicCode] on the public API. -->
    <IsAotCompatible>true</IsAotCompatible>
    <AssemblyName>MicroKit.Result</AssemblyName>
    <RootNamespace>MicroKit.Result</RootNamespace>
    <Description>Railway-oriented result type for .NET 10. Explicit success/failure without exceptions.</Description>
    <PackageTags>microkit;result;railway;functional;dotnet</PackageTags>
    <NoWarn>$(NoWarn);CA1716;CA1000</NoWarn>
  </PropertyGroup>
</Project>
