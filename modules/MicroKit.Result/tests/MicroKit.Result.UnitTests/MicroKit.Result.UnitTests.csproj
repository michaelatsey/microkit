<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- IL2026/IL3050: the JSON converter tests call APIs annotated [RequiresUnreferencedCode] /
         [RequiresDynamicCode] on purpose; this test project is never trimmed nor AOT-compiled. -->
    <NoWarn>$(NoWarn);CS1591;CA1707;IL2026;IL3050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroKit.Result/MicroKit.Result.csproj" />
  </ItemGroup>
</Project>
