<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A BenchmarkDotNet console app, like the Domain benchmarks project; Program.cs says how to run it. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1822: BenchmarkDotNet runs instance methods only. CA1707: benchmark names with underscores.
         CA1515: BenchmarkDotNet requires public benchmark types. -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1822;CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="ErrorOr" />
    <PackageReference Include="FluentResults" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroKit.Result/MicroKit.Result.csproj" />
  </ItemGroup>
</Project>
