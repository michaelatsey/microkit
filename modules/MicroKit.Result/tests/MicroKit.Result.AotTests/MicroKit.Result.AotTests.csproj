<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Unlike the other test projects, IL2026/IL3050 are not suppressed: Result<T> serialization must build without
         trim or AOT warnings, which are errors in Release. -->
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
    <!-- Reflection-based System.Text.Json is turned off, as in a trimmed or Native AOT app (Microsoft Learn, "How to
         use source generation in System.Text.Json", disable reflection defaults): every type goes through a
         JsonSerializerContext. The trim and AOT analyzers run at build time (Microsoft Learn, "Introduction to AOT
         warnings"), so a reflection path reached from this project fails the Release build. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroKit.Result/MicroKit.Result.csproj" />
  </ItemGroup>
</Project>
