<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MicroKit.Persistence.Abstractions</AssemblyName>
    <RootNamespace>MicroKit.Persistence.Abstractions</RootNamespace>
    <Description>Repository, Unit of Work, and transaction contracts for MicroKit.Persistence. Zero implementation — no EF Core, no infrastructure dependency.</Description>
    <PackageTags>persistence;repository;unit-of-work;transactions;microkit;ddd;dotnet;abstractions</PackageTags>
  </PropertyGroup>
  <!-- Cross-module: another MicroKit module is always referenced from source, with an unconditional
       ProjectReference in every build mode (#197 Spec, Perimeter) -->
  <ItemGroup>
    <ProjectReference Include="../../../MicroKit.Domain/src/MicroKit.Domain/MicroKit.Domain.csproj" />
  </ItemGroup>
</Project>
