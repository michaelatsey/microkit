<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MicroKit.Messaging.MediatR</AssemblyName>
    <RootNamespace>MicroKit.Messaging.MediatR</RootNamespace>
    <Description>MediatR glue for MicroKit.Messaging — puts MicroKit.MediatR domain events on the
    transactional outbox. Contributes an IDomainEventsSink that maps drained domain events to their
    notifications and stages them in the same transaction as the aggregate; decorates IOutboxDispatcher
    so a MessageKind.Notification row publishes via IPublisher.Publish while every other kind is
    delegated to the standard dispatcher; and replaces MediatR's notification publisher so domain
    events raised by notification handlers are dispatched too.</Description>
    <PackageTags>microkit;messaging;mediatr;outbox;domain-events;dotnet</PackageTags>
    <Authors>Ange-Michaël Atsé</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- CA1848/CA1873: simple logging is intentional for v1.
         IL2072/IL3050 were removed with the mechanism that needed them: the decorator no longer
         rebuilds its inner via ActivatorUtilities.CreateInstance on a runtime Type — it resolves it
         from the keyed OutboxDispatcherKeys.Standard slot (ADR-MSG-019). Verified clean on a full
         Release rebuild without them. Do not re-add speculatively: a live trim warning is
         information this build should surface. -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MicroKit.Messaging.MediatR.UnitTests" />
  </ItemGroup>

  <!-- Same-module reference — co-versioned with Messaging Core; no CIReleaseBuild pattern needed -->
  <ItemGroup>
    <ProjectReference Include="../MicroKit.Messaging/MicroKit.Messaging.csproj" />
  </ItemGroup>

  <!-- DEV: source ProjectReferences — CI/Release: published NuGet packages -->
  <!-- ⚠ Any new cross-module dependency must be added to BOTH ItemGroups -->
  <ItemGroup Condition="'$(CIReleaseBuild)' != 'true'">
    <ProjectReference Include="../../../MicroKit.MediatR/src/MicroKit.MediatR/MicroKit.MediatR.csproj" />
    <ProjectReference Include="../../../MicroKit.Domain/src/MicroKit.Domain/MicroKit.Domain.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(CIReleaseBuild)' == 'true'">
    <PackageReference Include="MicroKit.MediatR" />
    <PackageReference Include="MicroKit.Domain" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
