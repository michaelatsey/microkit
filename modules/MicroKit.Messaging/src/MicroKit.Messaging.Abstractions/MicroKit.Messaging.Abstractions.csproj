<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MicroKit.Messaging.Abstractions</AssemblyName>
    <RootNamespace>MicroKit.Messaging</RootNamespace>
    <Description>Pure contracts for MicroKit.Messaging, in two layers. The application surface in namespace MicroKit.Messaging — IIntegrationEvent, IntegrationEventAttribute, IIntegrationEventPublisher, IMessageHandler, MessageId, IntegrationEventPublishException, IntegrationEventConfigurationException, InboxDependencyUnavailableException — is what an application names. The MicroKit.Messaging.Spi namespace is the contract for authors of a store, a transport or a dispatcher — IMessageTransport, MessageEnvelope, IEnvelopeReceiver, IOutboxDispatcher, the outbox and inbox store interfaces, and the row types they exchange. Zero framework dependency.</Description>
    <PackageTags>microkit;messaging;outbox;inbox;integration-events;abstractions;dotnet</PackageTags>
    <Authors>Ange-Michaël Atsé</Authors>
    <PackageProjectUrl>https://github.com/michaelatsey/microkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/michaelatsey/microkit</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <!-- DEV: source ProjectReferences — CI/Release: published NuGet packages -->
  <!-- ⚠ Any new cross-module dependency must be added to BOTH ItemGroups -->
  <ItemGroup Condition="'$(CIReleaseBuild)' != 'true'">
    <ProjectReference Include="../../../MicroKit.Result/src/MicroKit.Result/MicroKit.Result.csproj" />
    <ProjectReference Include="../../../MicroKit.Domain/src/MicroKit.Domain/MicroKit.Domain.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(CIReleaseBuild)' == 'true'">
    <PackageReference Include="MicroKit.Result" />
    <PackageReference Include="MicroKit.Domain" />
  </ItemGroup>
</Project>
