<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MicroKit.Messaging</AssemblyName>
    <RootNamespace>MicroKit.Messaging</RootNamespace>
    <Description>Messaging core for MicroKit — the message bus (publish straight to a transport,
    receive pipeline with middleware and typed verdicts), the in-memory transport, System.Text.Json
    serialization, and the transitional outbox and inbox engine, with its DI extensions.</Description>
    <PackageTags>microkit;messaging;outbox;inbox;integration-events;dotnet</PackageTags>
    <Authors>Ange-Michaël Atsé</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- CA1848/CA1873: simple logging is intentional for v1 polling workload.
         IL2026/IL2057: SystemTextJsonMessageSerializer uses reflection-based serialization — v2 will use source generators.
         IL2091: AddTransient<THandler> is covered by DynamicallyAccessedMembers on the type param. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;IL2026;IL2057</NoWarn>
    <!-- MessagingOptions is bound from configuration (#187): the source generator replaces the
         reflection-based binder, which the module could not otherwise use (IsTrimmable). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MicroKit.Messaging.UnitTests" />
    <InternalsVisibleTo Include="MicroKit.Messaging.MediatR" />
    <!-- AddEfCoreIntegrationEvents<TContext>() registers the internal IntegrationEventPublisher
         next to the writer it requires (#187); the publisher stays internal to Core. -->
    <InternalsVisibleTo Include="MicroKit.Messaging.EntityFrameworkCore" />
    <!-- OutboxDomainEventSinkTests constructs the internal OutboxMessageFactory as a collaborator:
         ADR-MSG-008 §2 defers an IOutboxMessageMapper until a second implementation exists, so the
         sealed class cannot be doubled. -->
    <InternalsVisibleTo Include="MicroKit.Messaging.MediatR.UnitTests" />
    <!-- IInboxCoordinator / IOutboxCoordinator became internal with #185 (ADR-MSG-002's public
         surface is superseded; the database-per-tenant engine moved to #191). Three call sites
         drive one deterministic drain cycle and no public API offers that:
         InboxSettlementGuaranteeTests.cs:118, E2EHarness.cs:150 and :166. The first also binds the
         InboxBatchResult those seams return — internal for the same reason — and asserts on it.
         Removed by #135. -->
    <InternalsVisibleTo Include="MicroKit.Messaging.IntegrationTests" />
    <InternalsVisibleTo Include="MicroKit.Messaging.MediatR.IntegrationTests" />
    <!-- NSubstitute mocks the now-internal drain seams (IOutboxProcessor, IInboxProcessor,
         IOutboxCoordinator, IInboxCoordinator). Castle emits DynamicProxyGenAssembly2 UNSIGNED
         here (PublicKeyToken=null), so the strong-named grant below never matches it and the
         unqualified one is what actually grants access; without it every Substitute.For on those
         seams fails at runtime with TypeLoadException, not at compile time. Both lines are kept:
         this project is not strong-named, so only the unqualified grant is load-bearing today. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2, " />
  </ItemGroup>
  <!-- Same-module reference — Abstractions is in the same solution, no CIReleaseBuild pattern needed -->
  <ItemGroup>
    <ProjectReference Include="../MicroKit.Messaging.Abstractions/MicroKit.Messaging.Abstractions.csproj" />
  </ItemGroup>
  <!-- DEV: source ProjectReferences — CI/Release: published NuGet packages -->
  <!-- ⚠ Any new cross-module dependency must be added to BOTH ItemGroups -->
  <ItemGroup Condition="'$(CIReleaseBuild)' != 'true'">
    <ProjectReference Include="../../../MicroKit.Execution.Abstractions/src/MicroKit.Execution.Abstractions/MicroKit.Execution.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(CIReleaseBuild)' == 'true'">
    <PackageReference Include="MicroKit.Execution.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- ConfigureJson(Action<JsonSerializerOptions>) is backed by IOptions (#186). -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- MessagingOptions binds the "MicroKit:Messaging" section (#187). -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
</Project>
