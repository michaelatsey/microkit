#!/usr/bin/env bash
#
# git pre-push guard — refuse any push whose DESTINATION is a protected branch.
#
# This is the local backstop, and the only local layer that is actually complete.
# It does not pattern-match a command line; git has already resolved every
# spelling into a destination ref by the time this runs, so all of these are
# caught by the same few lines:
#
#   git push origin main
#   git push origin HEAD:main
#   git push origin main:main
#   git push -u origin main
#   git push origin main --force
#   git push                      (bare, on a main that tracks origin/main)
#   git push --all
#   git pp                        (any alias, however it expands)
#   any script or tool that shells out to git
#
# Bypassable with --no-verify, and local to this clone: a guardrail against
# mistakes, not a control against intent. GitHub branch protection on main is
# the control.
#
# Install:  git config core.hooksPath .githooks
#
# stdin: <local ref> <local oid> <remote ref> <remote oid>

set -uo pipefail

PROTECTED_REGEX="${GIT_PROTECTED_BRANCHES_REGEX:-^refs/heads/(main|master)$}"
remote_name="${1:-}"
status=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${remote_ref:-}" ] || continue
  if printf '%s' "$remote_ref" | grep -Eq "$PROTECTED_REGEX"; then
    branch="${remote_ref#refs/heads/}"
    {
      echo ""
      echo "  BLOCKED: direct push to protected branch '$branch' on '$remote_name'."
      echo "  Spelling used: ${local_ref:-<delete>} -> $remote_ref"
      echo ""
      echo "  Push a feature branch and open a PR:"
      echo "      git push -u $remote_name HEAD:refs/heads/feature/<scope>/<desc>"
      echo ""
    } >&2
    status=1
  fi
done

exit "$status"
